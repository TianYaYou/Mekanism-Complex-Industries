{
  "multipart": [
    {
      "apply": {
        "model": "mekanism_complex_industries:block/industrial_pipe_center"
      }
    },
    {
      "when": { "north": "true" },
      "apply": { "model": "mekanism_complex_industries:block/industrial_pipe_side" }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "mekanism_complex_industries:block/industrial_pipe_side", "y": 180 }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "mekanism_complex_industries:block/industrial_pipe_side", "y": 270 }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "mekanism_complex_industries:block/industrial_pipe_side", "y": 90 }
    },
    {
      "when": { "down": "true" },
      "apply": { "model": "mekanism_complex_industries:block/industrial_pipe_side", "x": 90 }
    },
    {
      "when": { "up": "true" },
      "apply": { "model": "mekanism_complex_industries:block/industrial_pipe_side", "x": 270 }
    }
  ]
}
